rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Check membership in a hostel
    function isHostelMember(hostelId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/hostels/$(hostelId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/hostels/$(hostelId)/members/$(request.auth.uid)).data.status == 'active';
    }

    // Get member role
    function getMemberRole(hostelId) {
      return get(/databases/$(database)/documents/hostels/$(hostelId)/members/$(request.auth.uid)).data.role;
    }

    function isHostelManager(hostelId) {
      return isHostelMember(hostelId) && getMemberRole(hostelId) == 'manager';
    }

    // -------------------------------------------------------------
    // Users Collection
    // -------------------------------------------------------------
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isUser(userId);
      allow delete: if false;
    }

    // -------------------------------------------------------------
    // Hostels Collection & Multi-Tenant Subcollections
    // -------------------------------------------------------------
    match /hostels/{hostelId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isHostelManager(hostelId);
      allow delete: if isHostelManager(hostelId);

      // Members Subcollection
      match /members/{memberId} {
        allow read: if isHostelMember(hostelId);
        allow create: if isAuthenticated() && (request.auth.uid == memberId || isHostelManager(hostelId));
        allow update: if isHostelManager(hostelId) || (isUser(memberId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'roomNumber', 'studentId', 'university', 'department', 'updatedAt']));
        allow delete: if isHostelManager(hostelId);
      }

      // Join Requests Subcollection
      match /joinRequests/{requestId} {
        allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isHostelManager(hostelId));
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'pending';
        allow update: if isHostelManager(hostelId);
        allow delete: if isHostelManager(hostelId) || (resource.data.userId == request.auth.uid && resource.data.status == 'pending');
      }

      // Approval Requests Subcollection
      match /approvalRequests/{requestId} {
        allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isHostelManager(hostelId));
        allow create: if isHostelMember(hostelId) && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'pending';
        allow update: if isHostelManager(hostelId);
        allow delete: if isHostelManager(hostelId);
      }

      // Group Chat
      match /groupChat/{messageId} {
        allow read, create: if isHostelMember(hostelId);
      }

      // Direct Messages
      match /directMessages/{channelId}/messages/{messageId} {
        allow read, create: if isHostelMember(hostelId);
      }

      // Months Subcollection
      match /months/{monthId} {
        allow read: if isHostelMember(hostelId);
        allow create, update: if isHostelManager(hostelId);
        allow delete: if isHostelManager(hostelId);
      }

      // Notices Subcollection
      match /notices/{noticeId} {
        allow read, create, update, delete: if isHostelMember(hostelId);
      }

      // Meals Subcollection
      match /meals/{mealId} {
        allow read: if isHostelMember(hostelId);
        allow create, update: if isHostelManager(hostelId) || (isHostelMember(hostelId) && request.resource.data.userId == request.auth.uid);
        allow delete: if isHostelManager(hostelId);
      }

      // Expenses Subcollection
      match /expenses/{expenseId} {
        allow read: if isHostelMember(hostelId);
        allow create, update, delete: if isHostelManager(hostelId);
      }

      // Deposits Subcollection
      match /deposits/{depositId} {
        allow read: if isHostelMember(hostelId);
        allow create: if isHostelManager(hostelId) || (isHostelMember(hostelId) && request.resource.data.userId == request.auth.uid);
        allow update: if isHostelManager(hostelId);
        allow delete: if isHostelManager(hostelId);
      }

      // Bazaar Subcollection
      match /bazaar/{bazaarId} {
        allow read: if isHostelMember(hostelId);
        allow create, update: if isHostelManager(hostelId) || (isHostelMember(hostelId) && resource.data.assignedTo == request.auth.uid);
        allow delete: if isHostelManager(hostelId);
      }

      // Transactions / Ledger Subcollection
      match /transactions/{transactionId} {
        allow read: if isHostelMember(hostelId);
        allow create, update, delete: if isHostelManager(hostelId);
      }

      // Reports Subcollection
      match /reports/{reportId} {
        allow read: if isHostelMember(hostelId);
        allow create, update: if isHostelManager(hostelId);
        allow delete: if isHostelManager(hostelId);
      }
    }
  }
}
